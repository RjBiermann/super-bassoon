<?xml version="1.0" encoding="utf-8"?>
<!--
    Swipe-player page surface (issue #8: black frame between swiped videos).
    Same two XML-only knobs the feed tiles' inline_player_view.xml uses:
    texture_view (NOT the default surface_view: a SurfaceView is a separate
    compositor layer that is BLACK until ExoPlayer paints its first frame —
    the reported black frame during every swipe's prepare window) and
    shutter_background_color=transparent (PlayerView's own shutter is opaque
    black by default, covering the surface until first frame regardless of
    surface type). The page composable keeps a poster underneath both, so the
    prepare window shows the poster instead of black. resize_mode stays at
    the default fit — the code re-asserts the user's videoFit pref on every
    update (PlayerScreen's update lambda), only the surface type has no
    programmatic setter, hence this 15-line XML.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:shutter_background_color="@android:color/transparent"
    app:use_controller="false"
    app:resize_mode="fit" />
