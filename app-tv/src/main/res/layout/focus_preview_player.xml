<?xml version="1.0" encoding="utf-8"?>
<!--
    TV preview-on-focus surface (AGENTS-UX-PATTERNS; quality pass, mobile
    inline_player_view.xml parity). texture_view (not the default
    surface_view): a SurfaceView is a separate window layer that is BLACK
    until ExoPlayer paints its first frame — the reported black frame before
    a preview starts. A TextureView renders inside the app window and stays
    transparent until real frames arrive, so the card's poster underneath
    stays visible through the whole attach/prepare window (no black window).
    shutter_background_color=transparent keeps PlayerView's own first-frame
    shutter see-through for the same reason. resize_mode=zoom is
    fill+center-crop — the same fill/crop semantics as the poster's
    ContentScale.Crop — so the first video frame lands exactly where the
    poster rendered (no visual jump at the settle swap). Muted looped glance
    only; the real player keeps its own surfaces.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:shutter_background_color="@android:color/transparent"
    app:use_controller="false"
    app:resize_mode="zoom" />
