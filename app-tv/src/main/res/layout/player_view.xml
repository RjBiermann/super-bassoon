<?xml version="1.0" encoding="utf-8"?>
<!--
    TV fullscreen player surface (issue #8: black frame at every D-pad
    switch / prepare stage). Same knobs as focus_preview_player.xml minus
    resize_mode=zoom: the fullscreen player must honor the shared videoFit
    pref — TvPlayerScreen re-asserts view.resizeMode on every update (only
    surface_type has no programmatic setter, hence this 15-line XML).
    texture_view (NOT the default surface_view: a SurfaceView is a separate
    compositor layer that is BLACK until ExoPlayer paints its first frame)
    and shutter_background_color=transparent (PlayerView's own shutter is
    opaque black by default) keep the page-under poster visible through the
    whole attach/prepare window.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:shutter_background_color="@android:color/transparent"
    app:use_controller="false"
    app:resize_mode="fit" />
